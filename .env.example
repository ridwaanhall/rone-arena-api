# FastAPI environment configuration

# Core
SECRET_KEY=your-secret-key-here
DEBUG=False
# Service restrictions. Both false = fully operational.
# Maintenance wins when both are set.
IS_MAINTENANCE=False
IS_HIGH_TRAFFIC=False
# Shown on the maintenance page as the expected return date.
DATE_AVAILABLE=Jul 30, 2026
PROJECT_VERSION=1.0.1

# Upstream game-data URLs
RONE_DEV_ACCESS_KEY=https://your-upstream-url.com/
RONE_DEV_ACCESS_KEY_V2=https://your-upstream-url-v2.com/

# Public links
BASE_URL=https://arena.rone.dev/
API_BASE_URL=https://arena.rone.dev/api/
DOCS_BASE_URL=https://arena.rone.dev/api/docs

# Production URLs (automatically switched based on request volume)
# Standard: 0-500 requests per day
PROD_URL_STANDARD=https://arena.rone.dev/api/
# High-Volume: 500+ requests per day (recommended)
PROD_URL_HIGH_VOLUME=https://arena-hv.fastapicloud.dev/api/
# Backward compatibility (uses standard URL)
PROD_URL=https://arena.rone.dev/api/

# Analytics is only emitted when the request hostname matches this value.
# Leave empty to disable analytics entirely.
ANALYTICS_HOST=arena-hv.fastapicloud.dev

# Optional metadata overrides
TWITTER_HANDLE=@ridwaanhall

# Local Development Note:
# When DEBUG=True, the web playground automatically uses http://127.0.0.1:8000/api/
# This avoids CORS issues when testing locally.
