{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rone-arena-api",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "DEBUG": "false",
    "IS_MAINTENANCE": "false",
    "IS_HIGH_TRAFFIC": "false",
    "BASE_URL": "https://arena.rone.dev/"
  },
  "secrets": {
    "required": ["SECRET_KEY", "RONE_DEV_ACCESS_KEY", "RONE_DEV_ACCESS_KEY_V2"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "python_modules": {
    "exclude": ["**/*.pyc", "**/__pycache__"]
  }
}
